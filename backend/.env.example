# 로컬 PostGIS (docker compose up -d)
DATABASE_URL=postgresql://mapgpt:mapgpt@localhost:5432/mapgpt
# 통합 테스트용 DB (없으면 테스트가 생성)
TEST_DATABASE_URL=postgresql://mapgpt:mapgpt@localhost:5432/mapgpt_test

# 별도 배포한 화면의 Origin을 JSON 배열로 지정 (경로·마지막 / 제외)
# 예: ["https://your-project.vercel.app","https://map.example.com"]
# 기본 []: 별도 Origin 허용 없음. 로컬 Vite 프록시 사용 시 설정 불필요
CORS_ALLOW_ORIGINS=[]

# LLM 공급자: openai | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Dataset 후보 검색(pgvector) 임베딩 모델. LLM_PROVIDER=ollama여도 OPENAI_API_KEY가 필요하다
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=granite4.1:8b
# thinking 모델의 추론 강도 (none이면 thinking을 꺼서 크게 빨라짐). 비우면 모델 기본값
OLLAMA_REASONING_EFFORT=
# LLM·임베딩 호출 하나의 타임아웃(초)과 재시도 횟수. 로컬 thinking 모델이 느리면 타임아웃을 늘린다
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# 분석 요청 비용·남용 방지 (POST /api/analyses)
# 클라이언트 IP별 요청 제한 (slowapi 형식, 예: 5/minute, 10/minute;100/day). 비우거나 0이면 끔
ANALYSIS_RATE_LIMIT=5/minute
# 한국 시간 자정부터 센 분석 실행 수의 하루 한도 (모든 클라이언트 합계). 0이면 제한 없음
ANALYSIS_DAILY_LIMIT=300

# 서울 열린데이터광장 인증키 (어린이집 ChildCareInfo API)
SEOUL_OPEN_API_KEY=

# 백그라운드 분석 작업 (POST /api/analysis-jobs): 동시 실행 수, 시간 제한(초, 0이면 없음)
ANALYSIS_MAX_CONCURRENCY=4
ANALYSIS_TIME_BUDGET_SECONDS=180
